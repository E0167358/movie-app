type Query {
    movies(page: Int = 0, size: Int = 20): MoviePage!
    movie(id: ID!): Movie
    people(page: Int = 0, size: Int = 20): PersonPage!
    person(id: ID!): Person
    search(query: String!, size: Int = 10): SearchResult!
}

type Mutation {
    createMovie(input: MovieInput!): Movie!
    updateMovie(id: ID!, input: MovieInput!): Movie!
    deleteMovie(id: ID!): Boolean!

    createPerson(input: PersonInput!): Person!
    updatePerson(id: ID!, input: PersonInput!): Person!
    deletePerson(id: ID!): Boolean!

    addCredit(input: CreditInput!): Credit!
    removeCredit(id: ID!): Boolean!
}

type Movie {
    id: ID!
    title: String!
    description: String
    releaseYear: Int
    genre: String
    durationMinutes: Int
    "null when no artwork is uploaded yet"
    artworkUrl: String
    credits: [Credit!]!
}

type Person {
    id: ID!
    name: String!
    bio: String
    birthYear: Int
    credits: [Credit!]!
}

"Links a person to a movie. ACTOR is cast, the other roles are creators."
type Credit {
    id: ID!
    role: Role!
    characterName: String
    person: Person!
    movieId: ID!
    "null if the movie does not exist anymore"
    movie: Movie
}

enum Role {
    ACTOR
    DIRECTOR
    WRITER
    PRODUCER
}

type MoviePage {
    items: [Movie!]!
    totalCount: Int!
}

type PersonPage {
    items: [Person!]!
    totalCount: Int!
}

"movies and people can be null, so one result still comes back if the other service fails"
type SearchResult {
    movies: MoviePage
    people: PersonPage
}

input MovieInput {
    title: String!
    description: String
    releaseYear: Int
    genre: String
    durationMinutes: Int
}

input PersonInput {
    name: String!
    bio: String
    birthYear: Int
}

input CreditInput {
    movieId: ID!
    personId: ID!
    role: Role!
    characterName: String
}
